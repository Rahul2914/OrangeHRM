<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<!--
  Parallelism is applied at class level: the lifecycle chain and the role-based checks
  are independent, so they execute concurrently on separate threads. The lifecycle class
  is annotated @Test(singleThreaded = true) so its ordered stages stay on one thread and
  keep sharing the employee record they create.
-->
<suite name="OrangeHRM Regression" parallel="classes" thread-count="2">
    <test name="Regression Coverage">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.orangehrm.assessment.tests.EmployeeLifecycleE2ETest"/>
            <class name="com.orangehrm.assessment.tests.RoleBasedAccessTest"/>
        </classes>
    </test>
</suite>