<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<!--
  Intentionally sequential: the smoke run is a single ordered lifecycle chain, so parallel
  execution would gain nothing and would risk racing on the shared employee record.
  Cross-suite parallelism is provided by the CI matrix; intra-suite parallelism lives in
  regression.xml.
-->
<suite name="OrangeHRM Smoke" parallel="false">
    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.orangehrm.assessment.tests.EmployeeLifecycleE2ETest"/>
        </classes>
    </test>
</suite>